# The versions the operator bundle installs, each with the checksum its
# download is checked against. install.sh reads this file; a component built
# from source is pinned by its commit. Sequentia Core is not pinned here: the
# node must run the release the network runs, so install.sh takes the newest
# release on the download page and checks it against that page's SHA256SUMS.

# Bitcoin Core: Bark's server needs 31 or later.
CORE_VERSION=31.1
CORE_SHA256=b80d9c3e04da78fb6f0569685673418cf686fadba9042d926d13fb87ff503f9e

# Core Lightning, the Bitcoin gateway: the release Bark's server is tested with.
CLN_VERSION=26.06.6
CLN_SHA256_UBUNTU_24_04=3214d71227f780a9a53cf264ab35cf452e0bdf43c1497ea406beedf2ad0af058

# Bark's server and watchman, from Second's release.
BARK_SERVER_VERSION=0.7.1
CAPTAIND_SHA256=38881e672f06751180f485e4d927487c4bd90363da69449ffee4ba57fde7212a
WATCHMAND_SHA256=aab9ae7d301be8a8a3e2864cce7315ec7644bfae5679915da966543e0e55ed17

# Bark's client, for the operator's own wallets: built from the same release
# with patches/bark-testnet4.patch, which adds testnet4 to its networks.
BARK_COMMIT=8f5d8c4f4afae87c8e4b3c6fb26fe06e9ae50e6a
BARK_PATCH_SHA256=1c253c40010751528903e1b3f318d00df86715721803cbd29e8e42e43bbea689

# Boltz's hold-invoice plugin for the Bitcoin gateway, built with
# patches/hold-testnet4.patch, without which it disables itself on testnet4.
HOLD_COMMIT=af0055b132f3b9f24d0b1d478a15005fcf8f014f
HOLD_PATCH_SHA256=e19b14e0c98db50f167d51fc8a879d64f8c60988c38bacecb5c9d0b86c68ce13

# SeqLN, the Sequentia gateway: built from its maintained branch at this commit.
SEQLN_COMMIT=f7af6a29a604981b36330d26a3a274873c9703ed

# Caddy, the TLS route (only when DOMAIN is set). SHA-512, as Caddy publishes.
CADDY_VERSION=2.11.7
CADDY_SHA512=a7a433a1b133efc3c8d10eb0b99d52a24b5ef5c322dc77f5282182b1c0402139ab83f3a99f0c52409df77d20123fb0b523edad8a66d8f5e49136197bf61ef0e7
