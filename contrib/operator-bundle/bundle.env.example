# The operator bundle's settings. install.sh reads them from
# /etc/arca-bundle/bundle.env (or the file BUNDLE_ENV names); copy this file
# there, fill in what is marked REQUIRED, and run install.sh again after any
# change. Secrets never go here: install.sh draws every key and password on the
# machine, into files only the bundle's user can read.

# --- What the operator serves ------------------------------------------------

# REQUIRED. The assets the operator serves, in order, separated by spaces, each
# as <asset id>:<smallest leaf in atoms>:<rate source>, the rate source being
# "node" (the node's own rate for the asset, where the node lists it) or
# "none". Nothing is served by default. Example (two assets):
#   ARCA_ASSETS="<asset id>:1000000:node <asset id>:1000000:none"
ARCA_ASSETS=""
# The assets a round's fee is paid in, in order: each must be accepted for
# fees by the node. Empty: the served assets that are.
ARCA_FEE_ASSETS=""
# The exit delay bounds, in 512-second units: 254 to 338 is 36 to 48 hours,
# the specification's. A test operator may set shorter ones (1 2).
ARCA_EXIT_DELAY_UNITS="254 338"
# How often a round is built while participations wait, in seconds.
ARCA_ROUND_INTERVAL=60
# How long a payment out of the tree may stay unresolved, in seconds. Another
# operator's invoice for a payment into its tree locks the payment for about
# 5,790 blocks at the specification's exit delays, and a payment may lock for
# at most half the time to its timeout less six hours: nine days serves it
# (and a swap of BTC for an asset, which needs four). It binds only a payment
# the operator never settles.
ARCA_SEND_TIMEOUT=777600

# --- The public route ----------------------------------------------------------

# A DNS name that points at this machine, with ports 80 and 443 reaching it.
# Caddy then serves the operator at https://<DOMAIN>/arca and the Bitcoin ark
# at https://<DOMAIN> with a certificate it obtains itself. Empty: no route;
# the operator answers only on this machine, and it cannot be listed in the
# registry, since a wallet refuses plain http to any other machine.
DOMAIN=""
# Who runs it: shown in the registry with the operator's record.
CONTACT_NAME=""
CONTACT_EMAIL=""
# The registry wallets find operators in.
REGISTRY_URL="https://sequentiatestnet.com/registry"

# --- The peer bundle: channels to its gateways -----------------------------------

# The operator whose gateways this bundle's gateways open channels to: its
# Arca server (its info names its SeqLN node and its Bitcoin gateway by key)
# and the host and ports the two gateways take peers at.
PEER_ARCA_URL="https://sequentiatestnet.com/arca"
PEER_HOST="sequentiatestnet.com"
PEER_SEQLN_PORT=19850
PEER_BTC_LN_PORT=19746
# The peer's gateways by node id, for a peer whose info does not name them
# yet (an asset's leg names its node only once it has a channel in the
# asset). Empty: read from the peer's info.
PEER_SEQLN_ID=""
PEER_BTC_LN_ID=""
# Each channel's size: in each served asset, in atoms (one figure for every
# asset, or <asset id>:<atoms> pairs), and on Bitcoin, in satoshis. Half of
# each is pushed to the peer, so payments run both ways from the start.
CHANNEL_ATOMS="2000000000"
CHANNEL_SAT=1000000

# --- The machine ------------------------------------------------------------------

# The bundle's name: its service user, the prefix of its systemd units, and
# its directories (/opt/<NAME>, /etc/<NAME>, /var/lib/<NAME>, /var/log/<NAME>).
# Two bundles on one machine take two names and two sets of ports.
NAME=arca-bundle
# Where the database's write-ahead log is archived as it is written, and where
# backups go. Put it on other storage than the machine's own disk.
BACKUP_DIR=""
# The chains: the public Sequentia testnet and Bitcoin testnet4.
SEQ_CHAIN=test
BTC_CHAIN=testnet4
# Parallel build jobs (Rust and C): each takes up to 2 GB of memory.
BUILD_JOBS=2
# The leaves the Bitcoin ark keeps ready for Lightning receives, each as
# <amount>:<count>: a receive into the ark is paid out of them, and with none
# ready it is failed back. Their total, and fees, come out of the round wallet.
ARK_VTXO_POOL="10000sat:10 50000sat:2"
# Limits on everything the bundle runs, together (its systemd slice), such
# as 4G and 200% (two cores). Empty: none.
BUNDLE_MEMORY_MAX=""
BUNDLE_CPU_QUOTA=""

# Where the operator, the ark and the nodes' RPC listen: 127.0.0.1 on a
# machine. The compose file sets 0.0.0.0 inside its containers and publishes
# those ports to the host's 127.0.0.1 alone.
LISTEN_HOST=127.0.0.1

# Ports. Every one listens on 127.0.0.1 alone, but for the two Lightning
# gateways, which take peers from anywhere, and Caddy's 80 and 443.
SEQ_RPC_PORT=18884
SEQ_P2P_PORT=18885
BTC_RPC_PORT=48332
BTC_P2P_PORT=48333
FEE_PROXY_PORT=48342
PG_PORT=5433
ARCAD_PORT=3535
ARCAD_METRICS_PORT=3536
SEQLN_PORT=9835
CLN_PORT=9935
CLN_GRPC_PORT=9937
HOLD_GRPC_PORT=9938
CAPTAIND_PORT=3545
CAPTAIND_ADMIN_PORT=3546
CAPTAIND_INTEGRATION_PORT=3547
