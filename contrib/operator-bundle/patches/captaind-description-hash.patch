diff --git a/server/src/ln/mod.rs b/server/src/ln/mod.rs
index 6b41663f4..8eb56a514 100644
--- a/server/src/ln/mod.rs
+++ b/server/src/ln/mod.rs
@@ -40,6 +40,45 @@ use crate::database::ln::{
 use crate::error::ContextExt;
 use crate::{check_max_amount, telemetry, Server, CAPTAIND_API_KEY};
 
+/// What a receive's invoice says about the payment: a memo (BOLT11 `d`), or
+/// the SHA-256 of a description given elsewhere (BOLT11 `h`), such as the
+/// LNURL-pay metadata a payer that checks the description hash compares it with.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ReceiveDescription {
+	Memo(String),
+	Hash([u8; 32]),
+}
+
+impl ReceiveDescription {
+	/// The description a receive request asks for: none, a memo, or a hash,
+	/// never both.
+	pub fn from_request(
+		memo: Option<String>,
+		hash: Option<Vec<u8>>,
+	) -> anyhow::Result<Option<ReceiveDescription>> {
+		match (memo, hash) {
+			(Some(_), Some(_)) => bail!("give a description or a description hash, not both"),
+			(None, Some(h)) => {
+				let h = <[u8; 32]>::try_from(h.as_slice()).map_err(|_| anyhow::anyhow!(
+					"a description hash has 32 bytes, not {}", h.len(),
+				))?;
+				Ok(Some(ReceiveDescription::Hash(h)))
+			},
+			(Some(m), None) => Ok(Some(ReceiveDescription::Memo(m))),
+			(None, None) => Ok(None),
+		}
+	}
+
+	/// The hold plugin's form of it.
+	pub fn into_hold(self) -> cln_rpc::plugins::hold::invoice_request::Description {
+		use cln_rpc::plugins::hold::invoice_request::Description;
+		match self {
+			ReceiveDescription::Memo(m) => Description::Memo(m),
+			ReceiveDescription::Hash(h) => Description::Hash(h.to_vec()),
+		}
+	}
+}
