 bark/src/config.rs                   |  4 ++
 bark/src/payment_request.rs          |  2 +-
 lib/src/lightning.rs                 | 75 ++++++++++++++++++++++++++++
 9 files changed, 97 insertions(+), 8 deletions(-)

